# ==============================================================================
# Amanah Healthcare Backend — Environment Configuration Template (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Jalankan `bun run setup:env` untuk menyalin file ini ke `.env` secara otomatis
#    dan mengenerate secret acak yang kuat (32 bytes hex) untuk development.
# 2. DILARANG meng-commit file `.env` yang berisi kredensial nyata ke git repository.
# ==============================================================================

# Runtime Environment
NODE_ENV=development
APP_RUNTIME=host
APP_NAME="Amanah Healthcare Backend"
APP_PORT=3001
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang

# Domains & Origin Policies
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000
APP_DEV_ORIGIN_PATTERNS=https://*.devtunnels.ms,https://*.ngrok-free.app,https://*.trycloudflare.com

# Timezones
CLINIC_TIMEZONE=Asia/Jakarta
PROCESS_TZ=Asia/Jakarta
DB_TIMEZONE=Asia/Jakarta

# Observability & Logging
LOG_LEVEL=info
LOG_PRETTY=true
HTTP_LOG_REQUEST_BODY=false
HTTP_LOG_RESPONSE_BODY=false
HTTP_LOG_MAX_BODY_LENGTH=1000
TRUST_PROXY=false

# PostgreSQL Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_USERNAME=amanah
DATABASE_PASSWORD=
DATABASE_NAME=amanah_healthcare
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# Redis Cache & Streams (Single Canonical URL: redis://<host>:<port>/<db_index>)
REDIS_URL=redis://localhost:6379/1
CACHE_KEY_PREFIX=amanah:development
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_READINESS_TIMEOUT_MS=1000
CACHE_MAX_RECONNECT_ATTEMPTS=10

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://amanah:amanah_secret@localhost:5672
RABBITMQ_USER=amanah
RABBITMQ_PASSWORD=
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# Mail & SMTP (Mailpit in development)
MAIL_HOST=localhost
MAIL_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_DEFAULT_EMAIL=noreply@amanah-healthcare.local
MAIL_DEFAULT_NAME="Amanah Healthcare"
MAIL_CLIENT_PORT=8025

# Better Auth & Security Secrets (Generated automatically by setup:env, min 32 chars)
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=8h
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_RESET_PASSWORD_PATH=/auth/sign-in/reset-password
AUTH_UNIFORM_ERRORS=false

# OAuth & External Providers (Optional in local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_APP_AUDIENCE=[]

# Push Notifications (Web Push VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@amanah-healthcare.local

# Storage Driver & Firebase
FILE_DRIVER=local
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-adminsdk.json

# Database Migration & Seed Switches
RUN_DB_MIGRATIONS=false
RUN_DB_SEED=false
