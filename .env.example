NODE_ENV=development
APP_PORT=3001
APP_NAME="Amanah Healthcare Backend"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000

CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_KEY_PREFIX=amanah:local
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_READINESS_TIMEOUT_MS=1000
CACHE_MAX_RECONNECT_ATTEMPTS=10
REDIS_HOST_PORT=6379

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_USERNAME=amanah
DATABASE_PASSWORD=amanah_secret
DATABASE_NAME=amanah_healthcare
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=postgresql://amanah:amanah_secret@127.0.0.1:5433/amanah_healthcare

FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@amanah-healthcare.local
MAIL_DEFAULT_NAME=Amanah Healthcare
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=development_secret_change_me
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=development_refresh_secret_change_me
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=development_forgot_secret_change_me
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=development_confirm_secret_change_me
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=true

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_APP_AUDIENCE=[]

WORKER_HOST=redis://localhost:6379/1
