{
  "name": "amanah-healthcare-backend",
  "version": "1.2.0",
  "description": "Amanah Healthcare - Clinical and Healthcare Operations Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "bun ./src/database/seeds/drizzle/seed.ts",
    "db:verify": "bun ./src/database/verify-foundation.ts",
    "drizzle:generate": "bun run db:generate",
    "drizzle:migrate": "bun run db:migrate",
    "drizzle:studio": "bun run db:studio",
    "seed:drizzle": "bun run db:seed:dev",
    "seed:create:relational": "hygen seeds create-relational",
    "postseed:create:relational": "npm run lint:fix",
    "generate:resource:relational": "hygen generate relational-resource",
    "postgenerate:resource:relational": "npm run lint:fix",
    "generate:resource:all-db": "hygen generate all-db-resource",
    "postgenerate:resource:all-db": "npm run lint:fix",
    "add:property:to-all-db": "hygen property add-to-all-db",
    "postadd:property:to-all-db": "npm run lint:fix",
    "add:property:to-relational": "hygen property add-to-relational",
    "postadd:property:to-relational": "npm run lint:fix",
    "app:config": "ts-node -r tsconfig-paths/register ./.install-scripts/index.ts && npm install && npm run lint:fix",
    "seed:run:relational": "bun run db:seed:dev",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:swc": "nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "env-cmd -- jest --config ./test/jest-e2e.json",
    "test:e2e:all": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-all-endpoints.ps1",
    "test:e2e:idempotency": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-idempotency.ps1",
    "test:e2e:problem-details": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-problem-details.ps1",
    "test:e2e:swagger": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-swagger-spec.ps1",
    "test:e2e:mobile": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-mobile-endpoints.ps1",
    "test:e2e:auth": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-better-auth-credentials.ps1",
    "test:e2e:email": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-email-infrastructure.ps1",
    "test:e2e:cache": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-cache-invalidation.ps1",
    "test:e2e:events": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-event-auditing.ps1",
    "test:e2e:pagination": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-keyset-pagination.ps1",
    "test:e2e:ratelimit": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-rate-limiting.ps1",
    "test:e2e:occ": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-optimistic-concurrency.ps1",
    "test:e2e:phases": "pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-phase1-crud.ps1 && pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-phase2-queue.ps1 && pwsh -ExecutionPolicy Bypass -File scripts/e2e/test-phase3-medical-records.ps1",
    "test:e2e:full-suite": "bun run test:e2e:all && bun run test:e2e:idempotency && bun run test:e2e:problem-details && bun run test:e2e:mobile && bun run test:e2e:swagger && bun run test:e2e:cache && bun run test:e2e:events && bun run test:e2e:pagination && bun run test:e2e:ratelimit && bun run test:e2e:occ",
    "test:generators:relational": "bash test/generators/run-static.sh relational",
    "test:e2e:generators:relational:docker": "bash test/generators/run-crud-relational.sh",
    "test:e2e:relational:docker": "docker compose -f docker-compose.relational.test.yaml --env-file env-example-relational -p tests up -d --build && docker compose -f docker-compose.relational.test.yaml -p tests exec api /opt/wait-for-it.sh -t 0 localhost:3001 -- npm run test:e2e -- --watchAll --runInBand && docker compose -f docker-compose.relational.test.yaml -p tests down && docker compose -p tests rm -svf",
    "prepare": "is-ci || husky",
    "release": "release-it"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1011.0",
    "@aws-sdk/s3-request-presigner": "3.1011.0",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.18",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/swagger": "11.2.6",
    "@types/multer-s3": "3.0.3",
    "@types/prompts": "2.4.9",
    "bcryptjs": "3.0.3",
    "better-auth": "^1.7.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.2",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ms": "2.1.3",
    "multer": "2.1.1",
    "multer-s3": "3.0.1",
    "nodemailer": "8.0.2",
    "passport": "0.7.0",
    "passport-anonymous": "1.0.1",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@release-it/conventional-changelog": "10.0.6",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.18",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-anonymous": "1.0.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "^0.31.10",
    "env-cmd": "11.0.0",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "is-ci": "4.1.0",
    "jest": "30.3.0",
    "prompts": "2.4.2",
    "release-it": "19.2.4",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "chore(deps)",
              "section": "Dependency Upgrades"
            },
            {
              "type": "fix(deps)",
              "section": "Dependency Upgrades"
            },
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Code Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "ci",
              "section": "Continuous Integration"
            }
          ]
        }
      }
    }
  }
}
