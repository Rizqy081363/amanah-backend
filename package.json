{
  "name": "amanah-healthcare-backend",
  "version": "1.2.0",
  "description": "Amanah Healthcare - Clinical and Healthcare Operations Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:visualize": "bun ./scripts/dev/visualize-erd.ts",
    "db:atlas": "bun ./tools/dbatlas/bin/cli.ts generate",
    "db:atlas:check": "bun ./tools/dbatlas/bin/cli.ts check",
    "db:atlas:doctor": "bun ./tools/dbatlas/bin/cli.ts doctor",
    "db:seed:dev": "bun ./src/database/seeds/drizzle/seed.ts",
    "db:seed:staff": "bun ./src/database/seeds/staff.seeder.ts",
    "db:seed:payroll": "bun ./src/database/seeds/payroll-attendance.seeder.ts",
    "db:verify": "bun ./src/database/verify-foundation.ts",
    "db:purge": "bun ./scripts/dev/purge-user.ts",
    "db:purge:user": "bun ./scripts/dev/purge-user.ts",
    "db:purge:attendance": "bun ./scripts/dev/purge-user.ts --attendance",
    "db:purge:attendance:today": "bun ./scripts/dev/purge-user.ts --attendance-today",
    "db:jwt": "bun ./scripts/dev/get-jwt-user.ts",
    "auth:token": "bun ./scripts/dev/get-jwt-user.ts",
    "db:backup": "powershell -ExecutionPolicy Bypass -File backup-db.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File restore-db.ps1",
    "backup": "powershell -ExecutionPolicy Bypass -File backup-db.ps1",
    "backup:pull": "powershell -ExecutionPolicy Bypass -File backup-db.ps1",
    "backup:pull:hook": "powershell -ExecutionPolicy Bypass -File backup-db.ps1 -FromGitHook",
    "backup:push": "powershell -ExecutionPolicy Bypass -File restore-db.ps1",
    "restore": "powershell -ExecutionPolicy Bypass -File restore-db.ps1",
    "vault:pack": "bun ./scripts/dev/pack-team-vault.ts",
    "vault:unpack": "bun ./scripts/dev/unpack-team-vault.ts",
    "pack:env": "bun ./scripts/dev/pack-team-vault.ts",
    "drizzle:generate": "bun run db:generate",
    "drizzle:migrate": "bun run db:migrate",
    "drizzle:studio": "bun run db:studio",
    "seed:drizzle": "bun run db:seed:dev",
    "seed:staff": "bun run db:seed:staff",
    "infra:up": "bun ./scripts/infra/infra.ts up",
    "infra:up:build": "bun ./scripts/infra/infra.ts up --build",
    "infra:down": "bun ./scripts/infra/infra.ts down",
    "infra:ps": "bun ./scripts/infra/infra.ts ps",
    "infra:logs": "bun ./scripts/infra/infra.ts logs",
    "seed:create:relational": "hygen seeds create-relational",
    "postseed:create:relational": "npm run lint:fix",
    "generate:resource:relational": "hygen generate relational-resource",
    "postgenerate:resource:relational": "npm run lint:fix",
    "generate:resource:all-db": "hygen generate all-db-resource",
    "postgenerate:resource:all-db": "npm run lint:fix",
    "add:property:to-all-db": "hygen property add-to-all-db",
    "postadd:property:to-all-db": "npm run lint:fix",
    "add:property:to-relational": "hygen property add-to-relational",
    "postadd:property:to-relational": "npm run lint:fix",
    "app:config": "ts-node -r tsconfig-paths/register ./.install-scripts/index.ts && npm install && npm run lint:fix",
    "seed:run:relational": "bun run db:seed:dev",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "bun ./scripts/dev/docker-sync.ts",
    "build:local": "NO_DOCKER=1 nest build",
    "build:docker": "bun run build",
    "docker:build": "docker compose build api && docker image prune -f",
    "docker:reload": "docker compose up -d --no-deps --build api && docker image prune -f",
    "docker:prune": "bun ./scripts/dev/docker-clean.ts",
    "docker:clean": "bun ./scripts/dev/docker-clean.ts",
    "docker:clean:orphans": "bun ./scripts/dev/docker-clean.ts --prune-orphans",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "deadcode": "knip",
    "deadcode:files": "knip --files",
    "deadcode:exports": "knip --exports",
    "deadcode:deps": "knip --dependencies",
    "deadcode:fix": "knip --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "log:interface": "bun ./scripts/dev/log-interface.ts",
    "docs:schedules": "bun ./scripts/generate-schedules-docs.ts",
    "start:swc": "nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "env-cmd -- jest --config ./test/jest-e2e.json",
    "test:e2e:all": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-all-endpoints.ps1",
    "test:e2e:idempotency": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-idempotency.ps1",
    "test:e2e:problem-details": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-problem-details.ps1",
    "test:e2e:swagger": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-swagger-spec.ps1",
    "test:e2e:mobile": "powershell -ExecutionPolicy Bypass -File ../amanah-healthcare-mobile/tests/test-flutter-mobile-contracts.ps1",
    "test:e2e:auth": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-better-auth-credentials.ps1",
    "test:e2e:email": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-email-infrastructure.ps1",
    "test:e2e:cache": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-cache-invalidation.ps1",
    "test:e2e:events": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-event-auditing.ps1",
    "test:e2e:pagination": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-keyset-pagination.ps1",
    "test:e2e:ratelimit": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-rate-limiting.ps1",
    "test:e2e:occ": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-optimistic-concurrency.ps1",
    "test:e2e:outbox": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-transactional-outbox.ps1",
    "test:e2e:schedule-v2": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-schedule-v2-projection.ps1",
    "test:e2e:schedule-security": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-schedule-v2-security-crud.ps1",
    "test:e2e:appointment": "powershell -ExecutionPolicy Bypass -File scripts/e2e/run-all-appointment-e2e.ps1",
    "test:e2e:payroll": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-attendance-payroll-mutations.ps1",
    "test:e2e:leave-scheduler": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-cron-leave-payroll-scheduler.ps1",
    "test:e2e:notifications": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-notifications-cross-client.ps1",
    "test:e2e:phases": "powershell -ExecutionPolicy Bypass -File scripts/e2e/test-phase1-crud.ps1 && powershell -ExecutionPolicy Bypass -File scripts/e2e/test-phase2-queue.ps1 && powershell -ExecutionPolicy Bypass -File scripts/e2e/test-phase3-medical-records.ps1",
    "test:e2e:full-suite": "bun run test:e2e:all && bun run test:e2e:idempotency && bun run test:e2e:problem-details && bun run test:e2e:mobile && bun run test:e2e:swagger && bun run test:e2e:cache && bun run test:e2e:events && bun run test:e2e:pagination && bun run test:e2e:ratelimit && bun run test:e2e:occ && bun run test:e2e:outbox",
    "test:generators:relational": "bash test/generators/run-static.sh relational",
    "test:e2e:generators:relational:docker": "bash test/generators/run-crud-relational.sh",
    "test:e2e:relational:docker": "docker-compose -f docker-compose.relational.test.yaml --env-file env-example-relational -p tests up -d --build && docker-compose -f docker-compose.relational.test.yaml -p tests exec api /opt/wait-for-it.sh -t 0 localhost:3001 -- bun run test:e2e -- --watchAll --runInBand && docker-compose -f docker-compose.relational.test.yaml -p tests down && docker-compose -p tests rm -svf",
    "prepare": "is-ci || husky",
    "release": "release-it",
    "patch": "bun ./tools/safe-edit/safe-edit.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1011.0",
    "@aws-sdk/s3-request-presigner": "3.1011.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.18",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/websockets": "^11.1.18",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer-s3": "3.0.3",
    "@types/prompts": "2.4.9",
    "amqplib": "^2.2.0",
    "bcryptjs": "3.0.3",
    "better-auth": "^1.7.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.8",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ms": "2.1.3",
    "multer": "2.1.1",
    "multer-s3": "3.0.1",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "8.0.2",
    "passport": "0.7.0",
    "passport-anonymous": "1.0.1",
    "passport-jwt": "4.0.1",
    "pdfmake": "^0.3.12",
    "pg": "8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@faker-js/faker": "^10.6.0",
    "@liam-hq/cli": "^0.7.24",
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@release-it/conventional-changelog": "10.0.6",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.18",
    "@types/adm-zip": "^0.6.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-anonymous": "1.0.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "7.2.0",
    "@types/web-push": "^3.6.4",
    "adm-zip": "^0.6.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "env-cmd": "11.0.0",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "is-ci": "4.1.0",
    "jest": "30.3.0",
    "knip": "^6.41.0",
    "pino-pretty": "^13.0.0",
    "prompts": "2.4.2",
    "release-it": "19.2.4",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@common/(.*)$": "<rootDir>/common/$1"
    }
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "chore(deps)",
              "section": "Dependency Upgrades"
            },
            {
              "type": "fix(deps)",
              "section": "Dependency Upgrades"
            },
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Code Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "ci",
              "section": "Continuous Integration"
            }
          ]
        }
      }
    }
  }
}
