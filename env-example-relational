NODE_ENV=development
APP_PORT=3001
APP_NAME="Amanah Healthcare Backend"
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000
RUN_DB_MIGRATIONS=true
RUN_DB_SEED=true
WAIT_TIMEOUT_SECONDS=60

CACHE_KEY_PREFIX=amanah:development
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_READINESS_TIMEOUT_MS=1000
CACHE_MAX_RECONNECT_ATTEMPTS=10
REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=amanah
DATABASE_PASSWORD=amanah_secret
DATABASE_NAME=amanah_healthcare
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

# SMTP & Email Infrastructure (Mailpit for local dev, VPS SMTP for production)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@amanah-healthcare.local
MAIL_DEFAULT_NAME="Amanah Healthcare"
MAIL_IGNORE_TLS=true
MAIL_REQUIRE_TLS=false


AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=false

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=amanah_better_auth_dev_secret_32_characters_minimum_len

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_APP_AUDIENCE=[]

